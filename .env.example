# ========================================================
# FormPilot AI Assistant Environment Configuration
# ========================================================
# 1. Copy this file and rename it to: .env
# 2. Add your Groq API Key below (from https://console.groq.com/keys)
# 3. FormPilot will automatically detect and load your key!

# Your Groq API Key (starts with gsk_...)
GROQ_API_KEY=your_groq_api_key_here

# The model to use for the AI Assistant
GROQ_MODEL=openai/gpt-oss-20b

